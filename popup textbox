// ==UserScript==
// @name         Google AI Studio 모바일 팝업 입력창 (v7.3.4)
// @namespace    https://aistudio.google.com/
// @version      7.3.4
// @description  라이트/다크 자동감지, 구글 보안 우회, 플로팅 버튼, 프롬프트 문구 적용
// @author       User
// @match        https://aistudio.google.com/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    // ==========================================
    // 1. CSS 스타일 및 테마 변수 정의
    // ==========================================
    const style = document.createElement('style');
    style.textContent = `
        /* 기본 다크 모드 변수 설정 */
        :root {
            --custom-bg: rgba(40, 40, 40, 0.95);
            --custom-modal-bg: #242424;
            --custom-text: #ffffff;
            --custom-text-muted: #888888;
            --custom-border: rgba(255, 255, 255, 0.15);
            --custom-btn-border: rgba(255, 255, 255, 0.2);
            --custom-copy-text: #cccccc;
            --custom-cancel-text: #ff8a8a;
            --custom-cancel-border: rgba(255, 138, 138, 0.3);
            --custom-submit-bg: #999999;
            --custom-submit-text: #ffffff;
            --custom-shadow: rgba(0, 0, 0, 0.6);
        }

        /* 라이트 모드 변수 덮어쓰기 */
        [data-theme="light"] {
            --custom-bg: rgba(255, 255, 255, 0.95);
            --custom-modal-bg: #ffffff;
            --custom-text: #111111;
            --custom-text-muted: #888888;
            --custom-border: rgba(0, 0, 0, 0.15);
            --custom-btn-border: rgba(0, 0, 0, 0.2);
            --custom-copy-text: #555555;
            --custom-cancel-text: #e53935;
            --custom-cancel-border: rgba(229, 57, 53, 0.3);
            --custom-submit-bg: #eeeeee;
            --custom-submit-text: #111111;
            --custom-shadow: rgba(0, 0, 0, 0.2);
        }

        /* 화면에 떠다니는 플로팅 버튼 */
        #custom-floating-btn {
            position: fixed;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px; 
            height: 40px;
            border-radius: 8px; 
            border: 1px solid var(--custom-btn-border);
            background: var(--custom-bg); 
            backdrop-filter: blur(4px);
            color: var(--custom-text);
            cursor: grab;
            z-index: 999998 !important;
            box-shadow: 0 4px 12px var(--custom-shadow);
            touch-action: none;
            transition: transform 0.1s, background 0.3s, color 0.3s;
        }
        #custom-floating-btn:active {
            cursor: grabbing;
            transform: scale(0.95);
        }

        /* 팝업창 본체 */
        #custom-aistudio-modal {
            display: none;
            position: fixed;
            background: var(--custom-modal-bg); 
            border-radius: 12px;
            padding: 12px;
            box-sizing: border-box;
            flex-direction: column;
            gap: 8px;
            box-shadow: 0 4px 25px var(--custom-shadow);
            border: 1px solid var(--custom-border);
            font-family: 'Pretendard', -apple-system, sans-serif;
            z-index: 999999 !important;
            transition: background 0.3s;
        }

        /* 상단 버튼 영역 (좌측 배치 변경) */
        .custom-modal-header {
            display: flex;
            justify-content: flex-start;
            gap: 8px;
        }

        /* 개별 버튼 기본 스타일 (테두리 제거) */
        .custom-modal-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            height: 30px;
            padding: 0;
            border: none;
            background: transparent !important;
            transition: all 0.2s;
        }

        /* 전체복사 버튼 (테두리 색상 맞춤) */
        .btn-copy { 
            background: transparent; 
            color: var(--custom-border); 
            width: 30px; 
        }

        /* 텍스트 입력창 */
        #custom-modal-textarea {
            width: 100%;
            background: transparent;
            border: none;
            color: var(--custom-text);
            font-size: 16px;
            line-height: 1.5;
            padding: 8px 4px;
            outline: none;
            resize: none;
            box-sizing: border-box;
            white-space: pre-wrap;
            word-break: break-all;
            transition: color 0.3s;
        }
        #custom-modal-textarea::placeholder { color: var(--custom-text-muted); }
    `;
    document.head.appendChild(style);

    // ==========================================
    // 2. DOM 객체 직접 생성 (구글 보안 우회)
    // ==========================================
    
    // 플로팅 버튼 생성
    const floatingBtn = document.createElement('div');
    floatingBtn.id = 'custom-floating-btn';

    const svgns = "http://www.w3.org/2000/svg";
    const svg = document.createElementNS(svgns, "svg");
    svg.setAttribute("fill", "currentColor");
    svg.setAttribute("viewBox", "0 0 20 20");
    svg.setAttribute("width", "24px");
    svg.setAttribute("height", "24px");
    const path = document.createElementNS(svgns, "path");
    path.setAttribute("d", "m13.8 2.58 1.1 3.4 3.4 1.09c.23.07.23.38 0 .46l-3.4 1.09-1.1 3.4a.24.24 0 0 1-.45 0l-1.1-3.4-3.4-1.1a.24.24 0 0 1 0-.45l3.4-1.1 1.1-3.4a.24.24 0 0 1 .46 0M7.5 5.25h-5V3.92h5zm0 5.42h-5V9.33h5zm-5 5.41h15v-1.33h-15z");
    svg.appendChild(path);
    floatingBtn.appendChild(svg);

    // 팝업창 생성
    const modal = document.createElement('div');
    modal.id = 'custom-aistudio-modal';

    const header = document.createElement('div');
    header.className = 'custom-modal-header';

    // 복사 버튼 생성 및 전달받은 SVG 객체 조립 (구글 보안 우회를 위해 안전한 DOM 방식으로 생성)
    const btnCopy = document.createElement('button');
    btnCopy.className = 'custom-modal-btn btn-copy';

    const copySvg = document.createElementNS(svgns, "svg");
    copySvg.setAttribute("width", "24");
    copySvg.setAttribute("height", "24");
    copySvg.setAttribute("viewBox", "0 0 24 24");
    copySvg.setAttribute("fill", "none");
    copySvg.setAttribute("stroke", "currentColor");
    copySvg.setAttribute("stroke-width", "2");
    copySvg.setAttribute("stroke-linecap", "round");
    copySvg.setAttribute("stroke-linejoin", "round");
    copySvg.setAttribute("class", "lucide lucide-copy-icon lucide-copy");

    const rect = document.createElementNS(svgns, "rect");
    rect.setAttribute("width", "14");
    rect.setAttribute("height", "14");
    rect.setAttribute("x", "8");
    rect.setAttribute("y", "8");
    rect.setAttribute("rx", "2");
    rect.setAttribute("ry", "2");

    const pathEl = document.createElementNS(svgns, "path");
    pathEl.setAttribute("d", "M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2");

    copySvg.appendChild(rect);
    copySvg.appendChild(pathEl);
    btnCopy.appendChild(copySvg);

    header.appendChild(btnCopy);

    // 텍스트 영역 생성
    const textarea = document.createElement('textarea');
    textarea.id = 'custom-modal-textarea';
    textarea.placeholder = '여기에 프롬프트를 입력하세요...';

    modal.appendChild(header);
    modal.appendChild(textarea);

    // ==========================================
    // 3. 유지 관리 및 테마 감지 (오리지널과 동일 구조 유지)
    // ==========================================
    const savedPos = localStorage.getItem('aistudio_btn_pos');
    if (savedPos) {
        const pos = JSON.parse(savedPos);
        floatingBtn.style.left = pos.left;
        floatingBtn.style.top = pos.top;
    } else {
        floatingBtn.style.right = '20px';
        floatingBtn.style.bottom = '100px';
    }

    // 라이트 모드 판단 함수
    function detectTheme() {
        const color = window.getComputedStyle(document.body).color;
        const match = color.match(/\d+/g);
        let isDarkTheme = true;
        
        if (match && match.length >= 3) {
            const brightness = (0.2126 * (+match[0]) + 0.7152 * (+match[1]) + 0.0722 * (+match[2]));
            isDarkTheme = brightness > 128; 
        }

        const themeAttr = isDarkTheme ? 'dark' : 'light';
        floatingBtn.setAttribute('data-theme', themeAttr);
        modal.setAttribute('data-theme', themeAttr);
    }

    // 1초마다 버튼 유지 및 테마 확인
    function ensureUIExists() {
        if (!document.body.contains(floatingBtn)) {
            document.body.appendChild(floatingBtn);
        }
        if (!document.body.contains(modal)) {
            document.body.appendChild(modal);
        }
        detectTheme();
    }
    setInterval(ensureUIExists, 1000);
    ensureUIExists();

    // ==========================================
    // 4. 드래그 로직 (오리지널과 동일 구조 유지)
    // ==========================================
    let isDragging = false;
    let hasMoved = false;
    let startX, startY, initialLeft, initialTop;

    function startDrag(e) {
        isDragging = true;
        hasMoved = false;
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        startX = clientX;
        startY = clientY;
        initialLeft = floatingBtn.offsetLeft;
        initialTop = floatingBtn.offsetTop;
    }

    function moveDrag(e) {
        if (!isDragging) return;
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        const dx = clientX - startX;
        const dy = clientY - startY;

        if (Math.abs(dx) > 5 || Math.abs(dy) > 5) hasMoved = true;

        if (hasMoved) {
            e.preventDefault();
            let newLeft = initialLeft + dx;
            let newTop = initialTop + dy;
            const maxLeft = window.innerWidth - floatingBtn.offsetWidth;
            const maxTop = window.innerHeight - floatingBtn.offsetHeight;
            
            newLeft = Math.max(0, Math.min(newLeft, maxLeft));
            newTop = Math.max(0, Math.min(newTop, maxTop));

            floatingBtn.style.left = newLeft + 'px';
            floatingBtn.style.top = newTop + 'px';
            floatingBtn.style.right = 'auto';
            floatingBtn.style.bottom = 'auto';
        }
    }

    function endDrag() {
        if (!isDragging) return;
        isDragging = false;
        if (hasMoved) {
            localStorage.setItem('aistudio_btn_pos', JSON.stringify({ left: floatingBtn.style.left, top: floatingBtn.style.top }));
        } else {
            openModal();
        }
    }

    floatingBtn.addEventListener('mousedown', startDrag);
    document.addEventListener('mousemove', moveDrag, { passive: false });
    document.addEventListener('mouseup', endDrag);

    floatingBtn.addEventListener('touchstart', startDrag, { passive: true });
    document.addEventListener('touchmove', moveDrag, { passive: false });
    document.addEventListener('touchend', endDrag);

    // ==========================================
    // 5. 팝업창 크기/위치 및 버튼 동작 로직
    // ==========================================
    const adjustHeight = () => {
        textarea.style.height = 'auto';
        const computed = window.getComputedStyle(textarea);
        const padding = parseInt(computed.paddingTop) + parseInt(computed.paddingBottom);
        const lineHeight = 24; 
        const maxHeight = (lineHeight * 10) + padding; 

        if (textarea.scrollHeight > maxHeight) {
            textarea.style.height = maxHeight + 'px';
            textarea.style.overflowY = 'auto';
        } else {
            textarea.style.height = textarea.scrollHeight + 'px';
            textarea.style.overflowY = 'hidden';
        }
        positionModal(); 
    };
    textarea.addEventListener('input', adjustHeight);

    // 전체 복사 동작 (보안 검회를 통과하기 위해 innerHTML 미사용 우회 구현)
    btnCopy.onclick = () => {
        if (!textarea.value) return;
        navigator.clipboard.writeText(textarea.value).then(() => {
            if (btnCopy.contains(copySvg)) {
                btnCopy.removeChild(copySvg);
            }
            const copyText = document.createElement('span');
            copyText.style.fontSize = '11px';
            copyText.style.fontWeight = 'bold';
            copyText.style.color = 'var(--custom-border)';
            copyText.textContent = '복사됨';
            btnCopy.appendChild(copyText);

            setTimeout(() => {
                if (btnCopy.contains(copyText)) {
                    btnCopy.removeChild(copyText);
                }
                btnCopy.appendChild(copySvg);
            }, 1500);
        });
    };

    // 데이터를 본문 입력창에 대입하고 모달 닫기
    function submitAndClose() {
        const originalInput = document.querySelector('textarea[formcontrolname="promptText"], textarea[aria-label="Enter a prompt"]');
        if (originalInput) {
            const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLTextAreaElement.prototype, "value").set;
            nativeInputValueSetter.call(originalInput, textarea.value);
            
            originalInput.dispatchEvent(new Event('input', { bubbles: true }));
            originalInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
        modal.style.display = 'none';
    }

    // 팝업이 .prompt-box-container의 레이아웃과 정확히 맞물려 뜨도록 조정
    function positionModal() {
        const container = document.querySelector('.prompt-box-container');
        if (!container || modal.style.display === 'none') return;

        const rect = container.getBoundingClientRect();
        
        modal.style.left = rect.left + 'px';
        modal.style.width = rect.width + 'px';
        modal.style.bottom = (window.innerHeight - rect.bottom) + 'px';
    }

    function openModal() {
        modal.style.display = 'flex';
        const originalInput = document.querySelector('textarea[formcontrolname="promptText"], textarea[aria-label="Enter a prompt"]');
        if(originalInput && originalInput.value) {
            textarea.value = originalInput.value;
        } else {
            textarea.value = '';
        }
        positionModal();
        adjustHeight();
        setTimeout(() => {
            textarea.focus();
            textarea.setSelectionRange(textarea.value.length, textarea.value.length);
        }, 50);
    }

    if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', positionModal);
    } else {
        window.addEventListener('resize', positionModal);
    }
    window.addEventListener('scroll', positionModal, true);

    // 모바일 터치 및 마우스 동작을 모두 포괄하는 바깥 영역 감지 ( submitAndClose 자동 트리거 )
    function handleOutsideTouch(e) {
        if (modal.style.display === 'flex') {
            if (e.target !== textarea && !btnCopy.contains(e.target)) {
                submitAndClose();
            }
        }
    }
    document.addEventListener('touchstart', handleOutsideTouch, { passive: true });
    document.addEventListener('mousedown', handleOutsideTouch);

})();
